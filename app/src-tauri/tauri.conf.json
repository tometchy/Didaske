{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Didaske",
  "version": "0.1.0",
  "identifier": "com.didaske.Didaske.Dev",
  "build": {
    "beforeBuildCommand": "node src-tauri/prepare.mjs",
    "beforeDevCommand": { "script": "node src-tauri/prepare.mjs", "wait": true },
    "frontendDist": "../dist-native"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [{ "label": "main", "title": "Didaske", "width": 1000, "height": 760 }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost https://raw.githubusercontent.com; object-src 'none'; base-uri 'self'; frame-src 'none'; form-action 'self'",
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "shortDescription": "A bilingual offline Bible reader",
    "category": "Education"
  }
}
